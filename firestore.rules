rules_version = '2';
// Security rules for Dalpak.
// Every phone signs in anonymously. A phone counts as an employee only after it writes
// sessions/{uid} with a phone number + employee number that match logins/{phone}.
// It counts as a manager only while managerSessions/{uid} holds the current manager PIN.
// A login marked viewer (the shared "בקרה" account) can read everything a manager can, and write nothing.
service cloud.firestore {
  match /databases/{database}/documents {
    function sessDoc() { return /databases/$(database)/documents/sessions/$(request.auth.uid); }
    function mgrDoc() { return /databases/$(database)/documents/managerSessions/$(request.auth.uid); }
    function loginDoc(phone) { return /databases/$(database)/documents/logins/$(phone); }
    function adminDoc() { return /databases/$(database)/documents/config/admin; }
    function ownerDoc() { return /databases/$(database)/documents/config/owner; }
    function reelDoc(id) { return /databases/$(database)/documents/reels/$(id); }
    function signedIn() { return request.auth != null; }
    function sess() { return get(sessDoc()).data; }
    function login() { return get(loginDoc(sess().phone)).data; }
    function isEmp() {
      return signedIn()
        && exists(sessDoc())
        && exists(loginDoc(sess().phone))
        && login().num == sess().num;
    }
    function isViewer() { return isEmp() && login().get('viewer', false) == true; }
    // Anyone who may change data: a linked employee who is not the read-only viewer.
    function isStaff() { return isEmp() && login().get('viewer', false) != true; }
    function myEmpId() { return login().empId; }
    // Manager = an employee marked as a permanent manager, or one who entered the current PIN.
    function isMgr() {
      return isStaff() && (
        login().get('admin', false) == true
        || (exists(mgrDoc()) && get(mgrDoc()).data.pin == get(adminDoc()).data.pin));
    }
    // Reads that managers have, which the viewer shares.
    function canSee() { return isMgr() || isViewer(); }
    function isOwner() { return isStaff() && login().get('owner', false) == true; }
    // Only the owner hands out permanent-manager or viewer rights. Before an owner exists, any manager may.
    function canSetFlags() { return isOwner() || !exists(ownerDoc()); }
    function flagsSame() {
      return request.resource.data.get('admin', false) == resource.data.get('admin', false)
        && request.resource.data.get('owner', false) == resource.data.get('owner', false)
        && request.resource.data.get('viewer', false) == resource.data.get('viewer', false);
    }
    // Only the owner (or anyone, before an owner exists) may mark a login as the owner's.
    function ownerFlagOk() {
      return request.resource.data.get('owner', false) == false
        || (canSetFlags() && existsAfter(ownerDoc()) && getAfter(ownerDoc()).data.empId == request.resource.data.empId);
    }
    // The owner's own records: nobody but the owner may read or change them.
    function notOwnerRec() { return resource.data.get('owner', false) != true || isOwner(); }
    function isOwnerEmp(id) { return exists(ownerDoc()) && get(ownerDoc()).data.empId == id; }
    function noFlags() {
      return request.resource.data.get('admin', false) == false && request.resource.data.get('viewer', false) == false;
    }
    // True only inside the one-time setup batch, before any manager PIN exists.
    function bootstrapping() { return signedIn() && !exists(adminDoc()) && existsAfter(adminDoc()); }
    function nowMs() { return request.time.toMillis(); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /config/public {
      allow read: if true;
      allow write: if isMgr() || bootstrapping();
    }
    match /config/admin {
      allow read: if false;
      allow create: if signedIn() && !exists(adminDoc())
        && request.resource.data.pin is string && request.resource.data.pin.matches('^[0-9]{4,6}$');
      allow update: if isMgr() && request.resource.data.old == resource.data.pin
        && request.resource.data.pin is string && request.resource.data.pin.matches('^[0-9]{4,6}$');
    }

    // Who the owner is stays private; config/public only says that one exists.
    match /config/owner {
      allow read: if isOwner();
      // Set once by a manager; after that only the owner can change it.
      allow create: if isMgr() && exists(/databases/$(database)/documents/employees/$(request.resource.data.empId));
      allow update, delete: if isOwner();
    }

    // Login records hold the employee numbers used to sign in, so even the viewer cannot list them.
    // The owner's record is hidden from other managers too: they list only records marked owner:false.
    match /logins/{phone} {
      allow get: if (isMgr() && notOwnerRec()) || (signedIn() && exists(sessDoc()) && sess().phone == phone);
      allow list: if isMgr() && resource.data.owner == false;
      allow create: if bootstrapping() || (isMgr() && ownerFlagOk() && (canSetFlags() || noFlags()));
      allow update: if isMgr() && notOwnerRec() && ownerFlagOk() && (canSetFlags() || flagsSame());
      allow delete: if isMgr() && (canSetFlags() || (resource.data.get('admin', false) == false
        && resource.data.get('owner', false) == false && resource.data.get('viewer', false) == false));
    }
    match /sessions/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.phone is string && request.resource.data.num is string
        && existsAfter(loginDoc(request.resource.data.phone))
        && getAfter(loginDoc(request.resource.data.phone)).data.num == request.resource.data.num;
    }
    match /managerSessions/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && (isStaff() || bootstrapping())
        && getAfter(adminDoc()).data.pin == request.resource.data.pin;
    }

    // The owner's employee record carries no phone or number and shows only as a permanent manager;
    // other managers may change only its name and wage.
    match /employees/{id} {
      allow read: if isEmp();
      allow create: if isMgr() || bootstrapping();
      allow update: if isMgr() && (!isOwnerEmp(id) || isOwner()
        || (!request.resource.data.keys().hasAny(['phone', 'num', 'owner']) && request.resource.data.get('admin', false) == true));
      allow delete: if isMgr() && (!isOwnerEmp(id) || isOwner());
    }

    match /shifts/{id} {
      // Everyone can see who is on shift right now; past shifts stay private.
      allow read: if canSee() || (isEmp() && (resource.data.empId == myEmpId() || resource.data.status == 'open'));
      allow create: if isMgr() || (isStaff() && request.resource.data.empId == myEmpId() && (
          (request.resource.data.status == 'open' && request.resource.data.end == null
            && math.abs(request.resource.data.start - nowMs()) < 300000)
          || (request.resource.data.status == 'pending' && request.resource.data.end <= nowMs()
            && request.resource.data.start < request.resource.data.end)));
      // Only the owner may edit recorded times. Managers approve, reject, extend or close an open shift.
      // An employee may only close their own open shift, without moving its start.
      allow update: if isOwner()
        || (isMgr() && (onlyChanges(['status', 'allowUntil'])
            || (resource.data.status == 'open' && onlyChanges(['end', 'status', 'allowUntil']))))
        || (isStaff() && resource.data.empId == myEmpId()
          && resource.data.status == 'open' && request.resource.data.status == 'approved'
          && request.resource.data.empId == resource.data.empId
          && request.resource.data.start == resource.data.start
          && request.resource.data.end <= nowMs() + 300000);
      allow delete: if isOwner();
    }

    match /inventory/{id} {
      allow read: if canSee() || (isEmp() && resource.data.cat in ['drinks', 'salads']);
      allow write: if isMgr();
    }

    match /drinkUpdates/{id} {
      allow read: if isEmp();
      allow create: if isMgr() || (isStaff() && request.resource.data.empId == myEmpId() && request.resource.data.status == 'pending');
      allow update: if isMgr() || (isStaff() && resource.data.status == 'pending'
          && request.resource.data.status == 'replaced' && onlyChanges(['status']));
      allow delete: if isMgr();
    }

    match /deliveries/{id} {
      allow read: if isEmp();
      allow create, delete: if isMgr();
      allow update: if isMgr() || (isStaff() && resource.data.get('arrived', false) != true
          && request.resource.data.arrived == true && request.resource.data.arrivedBy == myEmpId()
          && onlyChanges(['arrived', 'arrivedBy', 'arrivedAt']));
    }

    match /notifications/{id} {
      allow read: if canSee();
      allow update, delete: if isMgr();
      allow create: if isMgr() || (isStaff() && request.resource.data.type == 'info');
    }

    // Item notes are for managers only. Item photos: managers add them, employees see drink photos.
    match /itemNotes/{id} { allow read: if canSee(); allow write: if isMgr(); }
    match /itemImages/{id} {
      allow read: if canSee() || (isEmp() && resource.data.cat in ['drinks', 'salads']);
      allow create, update: if isMgr() && request.resource.data.get('data', '').size() < 400000
        && request.resource.data.get('url', '').size() < 2000;
      allow delete: if isMgr();
    }

    match /empPhotos/{id} {
      allow read: if isEmp();
      allow write: if (isMgr() || (isStaff() && id == myEmpId()))
        && (request.resource == null || (request.resource.data.data is string && request.resource.data.data.size() < 200000));
    }

    // Tasks: an employee sees their own and may only mark them seen or done.
    match /tasks/{id} {
      allow read: if canSee() || (isEmp() && resource.data.empId == myEmpId());
      allow create, delete: if isMgr();
      allow update: if isMgr() || (isStaff() && resource.data.empId == myEmpId() && onlyChanges(['done', 'seen', 'doneAt']));
    }

    // Days an employee cannot work.
    match /unavail/{id} {
      allow read: if canSee() || (isEmp() && resource.data.empId == myEmpId());
      allow create: if isMgr() || (isStaff() && request.resource.data.empId == myEmpId());
      allow update, delete: if isMgr() || (isStaff() && resource.data.empId == myEmpId());
    }

    match /suppliers/{id} { allow read: if canSee(); allow write: if isMgr(); }
    match /orders/{id} { allow read: if canSee(); allow write: if isMgr(); }
    match /grades/{id} { allow read: if canSee(); allow write: if isMgr(); }

    // Reels: short videos and photo posts that everyone sees for 72 hours.
    // The reel document is small; the video or photos live in reelParts and load only when watched.
    match /reels/{id} {
      allow read: if isEmp();
      allow create: if isStaff() && request.resource.data.by == myEmpId()
        && math.abs(request.resource.data.ts - nowMs()) < 600000
        && request.resource.data.get('poster', '').size() < 60000;
      // The author may finish the upload; anyone may set only their own reaction; managers anything.
      allow update: if isMgr()
        || (isStaff() && resource.data.by == myEmpId() && onlyChanges(['ready', 'parts', 'size', 'caption', 'tags']))
        || (isStaff() && onlyChanges(['reactions', 'views'])
            && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([myEmpId()])
            && request.resource.data.get('views', {}).diff(resource.data.get('views', {})).affectedKeys().hasOnly([myEmpId()]));
      // Only the author deletes a post; managers only clear posts older than 72 hours.
      allow delete: if (isStaff() && resource.data.by == myEmpId()) || (isMgr() && resource.data.ts < nowMs() - 259200000);
    }
    match /reelParts/{id} {
      allow read: if isEmp();
      allow create: if isStaff() && exists(reelDoc(request.resource.data.reel))
        && get(reelDoc(request.resource.data.reel)).data.by == myEmpId()
        && request.resource.data.data is string && request.resource.data.data.size() < 900000;
      allow delete: if exists(reelDoc(resource.data.reel)) && (
        (isStaff() && get(reelDoc(resource.data.reel)).data.by == myEmpId())
        || (isMgr() && get(reelDoc(resource.data.reel)).data.ts < nowMs() - 259200000));
    }
    match /reelComments/{id} {
      allow read: if isEmp();
      allow create: if isStaff() && request.resource.data.by == myEmpId()
        && request.resource.data.text is string && request.resource.data.text.size() <= 500;
      allow delete: if isMgr() || (isStaff() && (resource.data.by == myEmpId()
        || (exists(reelDoc(resource.data.reel)) && get(reelDoc(resource.data.reel)).data.by == myEmpId())));
    }

    // Deliveries and bonuses: an employee reports a delivery, a manager approves it with an amount.
    match /extras/{id} {
      allow read: if canSee() || (isEmp() && resource.data.empId == myEmpId());
      allow create: if isMgr() || (isStaff() && request.resource.data.empId == myEmpId()
        && request.resource.data.status == 'pending' && !('amount' in request.resource.data));
      allow update: if isMgr();
      allow delete: if isMgr() || (isStaff() && resource.data.empId == myEmpId() && resource.data.status == 'pending');
    }
  }
}
