rules_version = '2';
// Security rules for Dalpak.
// Employees sign in with their Google account. A Google account counts as an employee only after a manager
// approved it: members/{email} links it to an employee record and holds that employee's permissions.
// Each area of the app (till, products, inventory, deliveries, orders, hours, tasks, staff, shop management,
// reels, messages) has a level per employee: none, view or edit. The owner has everything.
// Two shared accounts still sign in with a phone number + number: the viewer ("בקרה", reads like a manager,
// writes nothing) and the poster ("חדשות מרקט", posts reels only). A phone counts as one of them after it writes
// sessions/{uid} with a phone number + number that match logins/{phone}.
service cloud.firestore {
  match /databases/{database}/documents {
    function sessDoc() { return /databases/$(database)/documents/sessions/$(request.auth.uid); }
    function loginDoc(phone) { return /databases/$(database)/documents/logins/$(phone); }
    function adminDoc() { return /databases/$(database)/documents/config/admin; }
    function ownerDoc() { return /databases/$(database)/documents/config/owner; }
    function reelDoc(id) { return /databases/$(database)/documents/reels/$(id); }
    function signedIn() { return request.auth != null; }

    // ---- Google accounts ----
    function email() { return request.auth.token.get('email', '').lower(); }
    function gOk() { return signedIn() && request.auth.token.get('email_verified', false) == true && email() != ''; }
    function memDoc() { return /databases/$(database)/documents/members/$(email()); }
    function isMember() { return gOk() && exists(memDoc()); }
    function mem() { return get(memDoc()).data; }
    function lvl(a) { return mem().get('perms', {}).get(a, 'none'); }

    // ---- shared phone accounts (viewer and poster) ----
    function sess() { return get(sessDoc()).data; }
    function login() { return get(loginDoc(sess().phone)).data; }
    function isPhoneAcct() {
      return signedIn()
        && exists(sessDoc())
        && exists(loginDoc(sess().phone))
        && login().num == sess().num
        && (login().get('viewer', false) == true || login().get('poster', false) == true);
    }
    function isPoster() { return isPhoneAcct() && login().get('poster', false) == true; }
    function isViewer() { return isPhoneAcct() && login().get('viewer', false) == true; }

    // Any signed-in account, including the reels-only poster account.
    function isAcct() { return isMember() || isPhoneAcct(); }
    // An employee or the viewer: everyone except the poster account.
    function isEmp() { return isMember() || isViewer(); }
    // Anyone who may change data: an approved employee (the viewer writes nothing).
    function isStaff() { return isMember(); }
    function myEmpId() { return isMember() ? mem().empId : login().empId; }
    function isOwner() { return isMember() && mem().get('owner', false) == true; }
    // Permission per area. The viewer sees what a manager sees.
    function canView(a) { return isOwner() || isViewer() || (isMember() && lvl(a) in ['view', 'edit']); }
    function canEdit(a) { return isOwner() || (isMember() && lvl(a) == 'edit'); }
    function canPost() { return isOwner() || isPoster() || (isMember() && lvl('reels') == 'edit'); }
    function canChat() { return isOwner() || (isMember() && lvl('chat') != 'none'); }
    function posterOk() { return request.resource.data.get('poster', false) == false || request.resource.data.empId == 'news'; }

    // Who the owner's employee record is (kept private, see config/owner).
    function isOwnerEmp(id) { return exists(ownerDoc()) && get(ownerDoc()).data.empId == id; }
    // True only inside the one-time setup batch of a new shop.
    function bootstrapping() { return signedIn() && !exists(adminDoc()) && existsAfter(adminDoc()); }
    function nowMs() { return request.time.toMillis(); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /config/public {
      allow read: if true;
      allow write: if canEdit('admin') || canEdit('staff') || bootstrapping();
    }
    match /config/admin {
      allow read: if false;
      allow create: if signedIn() && !exists(adminDoc())
        && request.resource.data.pin is string && request.resource.data.pin.matches('^[0-9]{4,6}$');
    }
    // Closing a shift by location: the shop's location, radius and waiting time.
    match /config/geo {
      allow read: if isEmp();
      allow write: if canEdit('admin')
        && request.resource.data.keys().hasOnly(['on', 'lat', 'lng', 'acc', 'radius', 'grace', 'ts']);
    }
    // Employee names only, so the poster account can show who posted.
    match /config/names {
      allow read: if isAcct();
      allow write: if canEdit('staff');
    }
    match /config/owner {
      allow read: if isOwner() || canView('staff');
      allow create: if canEdit('staff') && exists(/databases/$(database)/documents/employees/$(request.resource.data.empId));
      allow update, delete: if isOwner();
    }

    // ---- who may sign in ----
    // An approved Google account: which employee it is and what it may do.
    // The owner mark goes only with the owner's own employee record; only the owner may change the owner's account.
    match /members/{em} {
      allow read: if (gOk() && em == email()) || canView('staff');
      allow create: if (canEdit('staff') && ownerMarkOk()) || claimOk(em);
      allow update: if canEdit('staff') && ownerMarkOk() && (resource.data.get('owner', false) != true || isOwner());
      allow delete: if canEdit('staff') && (resource.data.get('owner', false) != true || isOwner());
    }
    function ownerMarkOk() {
      return request.resource.data.get('owner', false) == isOwnerEmp(request.resource.data.empId);
    }
    // Moving over from the old sign-in: a phone whose old login was already checked with this Google account
    // may approve itself, as the same employee. Managers keep full rights; others get the basic ones.
    function claimOk(em) {
      return gOk() && em == email()
        && exists(sessDoc()) && exists(loginDoc(sess().phone)) && login().num == sess().num
        && login().get('google', '') == email()
        && request.resource.data.empId == login().empId
        && (login().get('admin', false) == true || login().get('owner', false) == true
          || (request.resource.data.perms == { 'reels': 'edit', 'chat': 'edit' } && request.resource.data.get('owner', false) == false))
        && (request.resource.data.get('owner', false) == false || login().get('owner', false) == true);
    }
    // A Google account asking to join; a manager approves it.
    match /signups/{em} {
      allow read: if (gOk() && em == email()) || canView('staff');
      allow create, update: if gOk() && em == email() && !exists(memDoc())
        && request.resource.data.keys().hasOnly(['email', 'name', 'photo', 'ts'])
        && request.resource.data.email == email()
        && request.resource.data.get('photo', '').size() < 2000 && request.resource.data.get('name', '').size() < 200;
      allow delete: if canEdit('staff') || (gOk() && em == email());
    }
    // Phone sign-in records, now only for the viewer and poster accounts.
    match /logins/{phone} {
      allow get: if canEdit('staff') || (signedIn() && exists(sessDoc()) && sess().phone == phone);
      allow list: if canEdit('staff') && resource.data.owner == false;
      allow create, update: if canEdit('staff') && request.resource.data.get('owner', false) == false && posterOk()
        && (request.resource.data.get('viewer', false) == false || isOwner());
      allow delete: if canEdit('staff') && resource.data.get('owner', false) == false;
    }
    match /sessions/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.phone is string && request.resource.data.num is string
        && existsAfter(loginDoc(request.resource.data.phone))
        && getAfter(loginDoc(request.resource.data.phone)).data.num == request.resource.data.num;
    }
    match /managerSessions/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
    }

    // The owner's employee record: other staff managers may change only its name and wage.
    match /employees/{id} {
      allow read: if isEmp();
      allow create: if canEdit('staff') || bootstrapping();
      allow update: if canEdit('staff') && (!isOwnerEmp(id) || isOwner()
        || !request.resource.data.keys().hasAny(['phone', 'num', 'owner']));
      allow delete: if canEdit('staff') && !isOwnerEmp(id);
    }

    match /shifts/{id} {
      // Everyone can see who is on shift right now; past shifts stay private.
      allow read: if canView('hours') || (isEmp() && (resource.data.empId == myEmpId() || resource.data.status == 'open'));
      allow create: if canEdit('hours') || (isStaff() && request.resource.data.empId == myEmpId() && (
          (request.resource.data.status == 'open' && request.resource.data.end == null
            && math.abs(request.resource.data.start - nowMs()) < 300000)
          || (request.resource.data.status == 'pending' && request.resource.data.end <= nowMs()
            && request.resource.data.start < request.resource.data.end)));
      // Only the owner may edit recorded times. Hours managers approve, reject, extend or close an open shift.
      // An employee may only close their own open shift, without moving its start.
      allow update: if isOwner()
        || (canEdit('hours') && (onlyChanges(['status', 'allowUntil'])
            || (resource.data.status == 'open' && onlyChanges(['end', 'status', 'allowUntil', 'autoGeo', 'geoUnsure']))))
        || (isStaff() && resource.data.empId == myEmpId()
          && resource.data.status == 'open' && request.resource.data.status == 'approved'
          && request.resource.data.empId == resource.data.empId
          && request.resource.data.start == resource.data.start
          && request.resource.data.end <= nowMs() + 300000);
      allow delete: if isOwner();
    }

    // Where each open shift stands by location (written by the employee's own phone, read by the server).
    match /shiftGeo/{id} {
      allow read: if canView('hours') || (isEmp() && resource.data.emp == myEmpId());
      allow create, update: if isStaff() && request.resource.data.emp == myEmpId()
        && request.resource.data.keys().hasOnly(['emp', 'home', 'lastIn', 'outAt', 'dist', 'acc', 'unsure', 'ts']);
      allow delete: if canEdit('hours') || (isStaff() && resource.data.emp == myEmpId());
    }

    // Everyone sees drinks and salads; the rest of the stock needs a permission.
    match /inventory/{id} {
      allow read: if canView('inv') || canView('products') || canView('orders') || canView('pos')
        || (isEmp() && resource.data.cat in ['drinks', 'salads']);
      allow write: if canEdit('inv') || canEdit('products');
    }

    match /drinkUpdates/{id} {
      allow read: if isEmp();
      allow create: if canEdit('inv') || (isStaff() && request.resource.data.empId == myEmpId() && request.resource.data.status == 'pending');
      allow update: if canEdit('inv') || (isStaff() && resource.data.status == 'pending'
          && request.resource.data.status == 'replaced' && onlyChanges(['status']));
      allow delete: if canEdit('inv');
    }

    match /deliveries/{id} {
      allow read: if isEmp();
      allow create, delete: if canEdit('deliv');
      allow update: if canEdit('deliv') || (isStaff() && resource.data.get('arrived', false) != true
          && request.resource.data.arrived == true && request.resource.data.arrivedBy == myEmpId()
          && onlyChanges(['arrived', 'arrivedBy', 'arrivedAt']));
    }

    // Alerts for managers: requests for hours, stock updates, long shifts.
    match /notifications/{id} {
      allow read: if canView('hours') || canView('inv') || canView('staff');
      allow update, delete: if canEdit('hours') || canEdit('inv') || canEdit('staff');
      allow create: if canEdit('hours') || canEdit('inv') || (isStaff() && request.resource.data.type == 'info');
    }

    match /itemNotes/{id} {
      allow read: if canView('inv') || canView('products');
      allow write: if canEdit('inv') || canEdit('products');
    }
    match /itemImages/{id} {
      allow read: if canView('inv') || canView('products') || canView('pos') || (isEmp() && resource.data.cat in ['drinks', 'salads']);
      allow create, update: if (canEdit('inv') || canEdit('products')) && request.resource.data.get('data', '').size() < 400000
        && request.resource.data.get('url', '').size() < 2000;
      allow delete: if canEdit('inv') || canEdit('products');
    }

    match /empPhotos/{id} {
      allow read: if isAcct();
      allow write: if (canEdit('staff') || (canPost() && id == myEmpId()) || (isStaff() && id == myEmpId()))
        && (request.resource == null || (request.resource.data.data is string && request.resource.data.data.size() < 200000));
    }

    // Tasks: an employee sees their own and may only mark them seen or done.
    match /tasks/{id} {
      allow read: if canView('tasks') || (isEmp() && resource.data.empId == myEmpId());
      allow create, delete: if canEdit('tasks');
      allow update: if canEdit('tasks') || (isStaff() && resource.data.empId == myEmpId() && onlyChanges(['done', 'seen', 'doneAt']));
    }
    match /grades/{id} { allow read: if canView('tasks'); allow write: if canEdit('tasks'); }

    // Days an employee cannot work.
    match /unavail/{id} {
      allow read: if canView('hours') || (isEmp() && resource.data.empId == myEmpId());
      allow create: if canEdit('hours') || (isStaff() && request.resource.data.empId == myEmpId());
      allow update, delete: if canEdit('hours') || (isStaff() && resource.data.empId == myEmpId());
    }

    match /suppliers/{id} {
      allow read: if canView('orders') || canView('products');
      allow write: if canEdit('orders') || canEdit('products');
    }
    // Barcode, supplier price and selling price per item.
    match /prices/{id} {
      allow read: if canView('products') || canView('pos') || canView('orders') || canView('inv');
      allow write: if canEdit('products');
    }
    // The till's product list, in chunks of up to 700 products.
    match /catalog/{id} {
      allow read: if canView('products') || canView('pos');
      allow write: if canEdit('products');
    }
    match /orders/{id} { allow read: if canView('orders'); allow write: if canEdit('orders'); }
    // Bills from the till.
    match /sales/{id} { allow read: if canView('pos'); allow write: if canEdit('pos'); }

    // Reels: short videos and photo posts.
    // The reel document is small; the video or photos live in reelParts and load only when watched.
    match /reels/{id} {
      allow read: if isAcct();
      allow create: if canPost() && request.resource.data.by == myEmpId()
        && math.abs(request.resource.data.ts - nowMs()) < 600000
        && request.resource.data.get('poster', '').size() < 60000;
      // The author may finish the upload; anyone may set only their own reaction; shop managers anything.
      allow update: if canEdit('admin')
        || (canPost() && resource.data.by == myEmpId() && onlyChanges(['ready', 'parts', 'size', 'caption', 'tags']))
        || (isStaff() && onlyChanges(['reactions', 'views'])
            && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([myEmpId()])
            && request.resource.data.get('views', {}).diff(resource.data.get('views', {})).affectedKeys().hasOnly([myEmpId()]));
      allow delete: if (canPost() && resource.data.by == myEmpId()) || canEdit('admin');
    }
    match /reelParts/{id} {
      allow read: if isAcct();
      allow create: if canPost() && exists(reelDoc(request.resource.data.reel))
        && get(reelDoc(request.resource.data.reel)).data.by == myEmpId()
        && request.resource.data.data is string && request.resource.data.data.size() < 900000;
      allow delete: if canEdit('admin') || (exists(reelDoc(resource.data.reel))
        && canPost() && get(reelDoc(resource.data.reel)).data.by == myEmpId());
    }
    match /reelComments/{id} {
      allow read: if isAcct();
      allow create: if isStaff() && request.resource.data.by == myEmpId()
        && request.resource.data.text is string && request.resource.data.text.size() <= 500;
      allow delete: if canEdit('admin') || (isStaff() && (resource.data.by == myEmpId()
        || (exists(reelDoc(resource.data.reel)) && get(reelDoc(resource.data.reel)).data.by == myEmpId())));
    }

    // Private messages between two employees: only the two of them can read a conversation.
    // A message is sent as its author; only the recipient can mark it read; only the author can delete it.
    match /messages/{id} {
      allow read: if isStaff() && myEmpId() in resource.data.pair;
      allow create: if canChat() && request.resource.data.from == myEmpId()
        && request.resource.data.pair is list && request.resource.data.pair.size() == 2
        && myEmpId() in request.resource.data.pair && request.resource.data.to in request.resource.data.pair
        && request.resource.data.to != myEmpId()
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && math.abs(request.resource.data.ts - nowMs()) < 600000;
      // The recipient marks it read; either side can hide it from their own phone ("delete for me").
      allow update: if isStaff() && myEmpId() in resource.data.pair
        && onlyChanges(resource.data.to == myEmpId() ? ['read', 'hide'] : ['hide'])
        && (!('hide' in request.resource.data) || (request.resource.data.hide is list && request.resource.data.hide.size() <= 2
            && request.resource.data.hide.hasOnly(resource.data.pair)));
      allow delete: if isStaff() && resource.data.from == myEmpId();
    }
    // Phone notification tokens: each phone saves its own under the signed-in employee. Only the server reads them.
    match /pushTokens/{token} {
      allow create, update: if isStaff() && request.resource.data.emp == myEmpId() && request.resource.data.token == token
        && request.resource.data.keys().hasOnly(['emp', 'token', 'platform', 'ts']);
      allow delete: if isAcct() && resource.data.emp == myEmpId();
    }
    // Notification settings: each employee reads and writes only their own.
    match /pushPrefs/{emp} {
      allow read: if isStaff() && emp == myEmpId();
      allow write: if isStaff() && emp == myEmpId()
        && request.resource.data.keys().hasOnly(['msg', 'preview', 'task', 'shift', 'req', 'reels', 'alerts', 'quiet', 'quietFrom', 'quietTo', 'shabbat', 'ts']);
    }
    // A request for a test notification to yourself; the server sends it and deletes the request.
    match /pushTests/{id} {
      allow create: if isStaff() && request.resource.data.emp == myEmpId() && request.resource.data.keys().hasOnly(['emp', 'ts']);
    }

    // Deliveries and bonuses: an employee reports a delivery, an hours manager approves it with an amount.
    match /extras/{id} {
      allow read: if canView('hours') || (isEmp() && resource.data.empId == myEmpId());
      allow create: if canEdit('hours') || (isStaff() && request.resource.data.empId == myEmpId()
        && request.resource.data.status == 'pending' && !('amount' in request.resource.data));
      allow update: if canEdit('hours');
      allow delete: if canEdit('hours') || (isStaff() && resource.data.empId == myEmpId() && resource.data.status == 'pending');
    }
  }
}
